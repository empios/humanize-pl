# OpenAI-compatible Chat Completions endpoint. Copy this file to .env.
HUMANIZE_PL_LLM_BASE_URL=https://model.example.com/v1
HUMANIZE_PL_LLM_MODEL=polish-legal-model
HUMANIZE_PL_LLM_API_KEY=
HUMANIZE_PL_LLM_TIMEOUT_SECONDS=120
# Ile fragmentów naprawdę leci do modelu naraz. Fragmenty są niezależne,
# więc to czysty zysk na zegarze — ale lokalny serwer i tak ma sufit
# przepustowości: zmierzone 1,25x przy 3. Ustaw 1, żeby wrócić do
# przebiegu sekwencyjnego.
HUMANIZE_PL_LLM_CONCURRENCY=3
# 1 = poproś model rozumujący (Qwen, MiMo…), żeby nie „myślał” przed
# odpowiedzią: ok. 30% mniej tokenów na fragment. Ścisły endpoint OpenAI
# odrzuca to pole, więc domyślnie 0.
HUMANIZE_PL_LLM_DISABLE_THINKING=0
# Limit długości odpowiedzi w tokenach. Puste = domyślny limit serwera; serwer
# mlx_lm ucina odpowiedź po 512 tokenach, a odpowiedź powtarza akapit przed
# redakcją: najdłuższy akapit z 24 testowych e-maili zajął 511. Dla mlx_lm
# ustaw np. 4096.
HUMANIZE_PL_LLM_MAX_TOKENS=
