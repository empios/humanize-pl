# OpenAI-compatible Chat Completions endpoint. Copy this file to .env.
HUMANIZE_PL_LLM_BASE_URL=https://model.example.com/v1
HUMANIZE_PL_LLM_MODEL=polish-legal-model
HUMANIZE_PL_LLM_API_KEY=
# Łączny limit pojedynczego zapytania, także jego ponowień.
HUMANIZE_PL_LLM_TIMEOUT_SECONDS=120
# Równoległe fragmenty w ścieżce prawnej; 1 oznacza pracę sekwencyjną.
# Ogólna redakcja akapitów przebiega sekwencyjnie.
HUMANIZE_PL_LLM_CONCURRENCY=3
# Reasoning models (np. Qwen 3.5): 1 = nie myśl przed odpowiedzią (chat_template_kwargs).
HUMANIZE_PL_LLM_DISABLE_THINKING=0
